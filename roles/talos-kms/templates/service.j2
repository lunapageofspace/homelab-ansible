[Unit]
Description=Talos Cluster KMS
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/podman run --name talos-kms --replace \
    -p {{ talos_kms_api_port }}:{{ talos_kms_api_port }} \
    -v {{ talos_kms_key_path }}:/kms.key:Z \
    -v {{ certenroll_private_key_path }}:/tls.key.pem:Z \
    -v {{ certenroll_crt.filename }}:/tls.crt.pem:Z \
    ghcr.io/siderolabs/kms-server:v0.2.0 \
        --tls-enable \
        --tls-key-path /tls.key.pem \
        --tls-cert-path /tls.crt.pem \
        --kms-api-endpoint=0.0.0.0:{{ talos_kms_api_port }} \
        --key-path=/kms.key

[Install]
WantedBy=multi-user.target